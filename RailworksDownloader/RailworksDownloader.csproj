<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <ApplicationVersion>1.0.0.%2a</ApplicationVersion>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
	
  <PropertyGroup>
    <StartupObject>RailworksDownloader.App</StartupObject>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>dls.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup>
    <RootNamespace>$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="Microsoft.VisualBasic" Version="10.3.0" />
    <PackageReference Include="ModernWpfUI">
      <Version>0.9.6</Version>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json">
      <Version>13.0.3</Version>
    </PackageReference>
    <PackageReference Include="Resource.Embedder">
      <Version>2.2.0</Version>
    </PackageReference>
    <PackageReference Include="Sentry">
      <Version>5.0.0</Version>
    </PackageReference>
    <PackageReference Include="SharpZipLib">
      <Version>1.4.2</Version>
    </PackageReference>
    <PackageReference Include="SteamKit2">
      <Version>3.0.0</Version>
    </PackageReference>
    <PackageReference Include="System.Data.SQLite.Core">
      <Version>1.0.119</Version>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters" Version="1.4.0" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="dls.ico" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="dls.png" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="BinParser.cs" />
  </ItemGroup>
</Project>